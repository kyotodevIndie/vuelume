{
  "name": "@vuelume/project-analyzer",
  "version": "0.1.0",
  "description": "Discovers Vue components in a project directory and builds a ProjectModel.",
  "keywords": [
    "vue",
    "sfc",
    "analyzer",
    "components",
    "props"
  ],
  "homepage": "https://github.com/kyotodevIndie/vuelume#readme",
  "bugs": {
    "url": "https://github.com/kyotodevIndie/vuelume/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyotodevIndie/vuelume.git",
    "directory": "packages/project-analyzer"
  },
  "license": "MIT",
  "author": "Thallys Morais",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@vuelume/project-model": "workspace:*",
    "@vuelume/vue-code-engine": "workspace:*"
  }
}
